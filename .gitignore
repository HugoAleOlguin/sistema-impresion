# Dependencias
node_modules/

# Datos temporales, archivos subidos por clientes y registros de impresión
server/data/uploads/*
!server/data/uploads/.gitkeep
server/data/mock_prints/*
!server/data/mock_prints/.gitkeep
server/data/*.pdf
server/data/*.json
server/data/*.log

# Binarios y ejecutables (se descargan automáticamente con scripts/install.ps1)
server/bin/*
!server/bin/.gitkeep

# Archivos generados durante pruebas locales
test/*.pdf
test/*.png
test/*.rtf
test/*.docx

# Logs y variables de entorno locales
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
